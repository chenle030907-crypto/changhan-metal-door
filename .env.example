PORT=3000
HOST=0.0.0.0

# Optional: forward every valid inquiry JSON payload to a webhook
# Example targets: enterprise WeChat bot, Feishu bot, Make/Zapier webhook, custom CRM endpoint
INQUIRY_WEBHOOK_URL=

# generic | wecom | feishu | dingtalk
INQUIRY_NOTIFY_PROVIDER=generic

# true: save to data/inquiries.jsonl; false: require webhook delivery for online deployments
PERSIST_INQUIRIES=true

# Basic anti-spam limit per IP
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=8

# Optional: write inquiry records outside the project folder
DATA_DIR=
